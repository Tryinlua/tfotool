        function getClosestColor(r, g, b, activeColors, method) {
            let minDist = Infinity;
            let closest = activeColors[0];

            for (let i = 0; i < activeColors.length; i++) {
                const c = activeColors[i];
                let dist = 0;

                if (method === 'ciede2000' || method === 'cielab') {
                    const lab1 = rgbToLab(r, g, b);
                    const lab2 = c.lab;
                    dist = Math.pow(lab1[0] - lab2[0], 2) + Math.pow(lab1[1] - lab2[1], 2) + Math.pow(lab1[2] - lab2[2], 2);
                } else if (method === 'redmean') {
                    const rmean = (r + c.rgb[0]) / 2;
                    const dr = r - c.rgb[0], dg = g - c.rgb[1], db = b - c.rgb[2];
                    dist = (2 + rmean/256) * dr*dr + 4 * dg*dg + (2 + (255-rmean)/256) * db*db;
                } else if (method === 'rgb') {
                    dist = Math.pow(r - c.rgb[0], 2) + Math.pow(g - c.rgb[1], 2) + Math.pow(b - c.rgb[2], 2);
                } else if (method === 'manhattan') {
                    dist = Math.abs(r - c.rgb[0]) + Math.abs(g - c.rgb[1]) + Math.abs(b - c.rgb[2]);
                }

                if (dist < minDist) {
                    minDist = dist;
                    closest = c;
                }
            }
            return closest.rgb;
        }

        function removeSmartBackground(data, width, height, tolerance) {
            const visited = new Uint8Array(width * height);
            const queue = [];
            const cornerIndices = [0, width - 1, (height - 1) * width, height * width - 1];

            function colorDiff(idx1, idx2) {
                return Math.abs(data[idx1] - data[idx2]) + Math.abs(data[idx1+1] - data[idx2+1]) + Math.abs(data[idx1+2] - data[idx2+2]);
            }

            let refR = 0, refG = 0, refB = 0;
            cornerIndices.forEach(ci => {
                refR += data[ci * 4]; refG += data[ci * 4 + 1]; refB += data[ci * 4 + 2];
            });
            refR /= 4; refG /= 4; refB /= 4;

            cornerIndices.forEach(idx => {
                queue.push(idx);
                visited[idx] = 1;
            });

            const maxDiff = tolerance * 4.5;

            while (queue.length > 0) {
                const curr = queue.shift();
                const currIdx = curr * 4;
                const diffFromRef = Math.abs(data[currIdx] - refR) + Math.abs(data[currIdx+1] - refG) + Math.abs(data[currIdx+2] - refB);
                
                if (diffFromRef <= maxDiff * 1.5) {
                    data[currIdx + 3] = 0;
                    const x = curr % width;
                    const y = Math.floor(curr / width);

                    const neighbors = [];
                    if (x > 0) neighbors.push(curr - 1);
                    if (x < width - 1) neighbors.push(curr + 1);
                    if (y > 0) neighbors.push(curr - width);
                    if (y < height - 1) neighbors.push(curr + width);

                    neighbors.forEach(nIdx => {
                        if (!visited[nIdx]) {
                            visited[nIdx] = 1;
                            if (colorDiff(currIdx, nIdx * 4) <= maxDiff) {
                                queue.push(nIdx);
                            }
                        }
                    });
                }
            }
        }

        function render() {
            const activeColors = processedPalette.filter(c => c.active);
            if (activeColors.length === 0) return;

            let maxPixels = parseInt(pixelInput.value) || 120;
            if (maxPixels < 1) maxPixels = 1;
            if (maxPixels > 3000) maxPixels = 3000;

            let width = loadedImage.width;
            let height = loadedImage.height;

            if (width > height) {
                height = Math.round((height * maxPixels) / width);
                width = maxPixels;
            } else {
                width = Math.round((width * maxPixels) / height);
                height = maxPixels;
            }

            pixelCanvas.width = width;
            pixelCanvas.height = height;

            statDim.textContent = `${width} x ${height}`;
            statTotal.textContent = (width * height).toLocaleString();

            const ctx = pixelCanvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;
            ctx.drawImage(loadedImage, 0, 0, width, height);

            const imgData = ctx.getImageData(0, 0, width, height);
            const data = imgData.data;

            if (brightnessOffset !== 0) {
                for (let i = 0; i < data.length; i += 4) {
                    data[i] = Math.min(255, Math.max(0, data[i] + brightnessOffset));
                    data[i+1] = Math.min(255, Math.max(0, data[i+1] + brightnessOffset));
                    data[i+2] = Math.min(255, Math.max(0, data[i+2] + brightnessOffset));
                }
            }

            if (removeBgToggle.checked) {
                removeSmartBackground(data, width, height, parseInt(bgTolInput.value));
            }

            const useDither = ditherToggle.checked;
            const selectedAlgo = algoSelect.value;

            if (!useDither) {
                for (let i = 0; i < data.length; i += 4) {
                    if (data[i + 3] < 128) continue;
                    const [r, g, b] = getClosestColor(data[i], data[i+1], data[i+2], activeColors, selectedAlgo);
                    data[i] = r; data[i+1] = g; data[i+2] = b;
                }
            } else {
                let errors = new Float32Array(data.length);
                for(let i = 0; i < data.length; i++) errors[i] = data[i];

                for (let y = 0; y < height; y++) {
                    for (let x = 0; x < width; x++) {
                        const idx = (y * width + x) * 4;
                        if (data[idx + 3] < 128) continue;

                        let oldR = Math.min(255, Math.max(0, errors[idx]));
                        let oldG = Math.min(255, Math.max(0, errors[idx + 1]));
                        let oldB = Math.min(255, Math.max(0, errors[idx + 2]));

                        const [newR, newG, newB] = getClosestColor(oldR, oldG, oldB, activeColors, selectedAlgo);
                        data[idx] = newR; data[idx + 1] = newG; data[idx + 2] = newB;

                        let errR = oldR - newR, errG = oldG - newG, errB = oldB - newB;

                        if (x + 1 < width) {
                            let n = idx + 4;
                            errors[n] += errR * 7/16; errors[n+1] += errG * 7/16; errors[n+2] += errB * 7/16;
                        }
                        if (y + 1 < height) {
                            if (x > 0) {
                                let n = idx + (width - 1) * 4;
                                errors[n] += errR * 3/16; errors[n+1] += errG * 3/16; errors[n+2] += errB * 3/16;
                            }
                            let n2 = idx + width * 4;
                            errors[n2] += errR * 5/16; errors[n2+1] += errG * 5/16; errors[n2+2] += errB * 5/16;
                            if (x + 1 < width) {
                                let n3 = idx + (width + 1) * 4;
                                errors[n3] += errR * 1/16; errors[n3+1] += errG * 1/16; errors[n3+2] += errB * 1/16;
                            }
                        }
                    }
                }
            }

            ctx.putImageData(imgData, 0, 0);
        }

