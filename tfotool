<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TFO Tools — WPLACE Suite Ultimate</title>
    <style>
        :root {
            --bg-dark: #080b11;
            --panel-bg: #111827;
            --panel-border: #1f293d;
            --accent: #3b82f6;
            --accent-hover: #60a5fa;
            --text-main: #f3f4f6;
            --text-sub: #9ca3af;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* --- CONNEXION --- */
        #loginOverlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(8, 11, 17, 0.95);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .login-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            padding: 30px;
            border-radius: 16px;
            width: 350px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            text-align: center;
        }

        .login-card h2 { font-size: 1.4rem; color: #fff; }
        .login-card p { font-size: 0.8rem; color: var(--text-sub); }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            text-align: left;
        }

        .form-group label {
            font-size: 0.75rem;
            color: var(--text-sub);
            font-weight: 700;
            text-transform: uppercase;
        }

        input[type="text"], input[type="password"], input[type="number"], input[type="datetime-local"], select {
            background: #080b11;
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            color: #fff;
            padding: 10px 12px;
            font-size: 0.9rem;
            outline: none;
            width: 100%;
        }

        input:focus, select:focus { border-color: var(--accent); }

        .btn-primary {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-primary:hover { background: var(--accent-hover); }

        /* --- LAYOUT --- */
        .sidebar {
            width: 260px;
            background-color: #0d131f;
            border-right: 1px solid var(--panel-border);
            display: flex;
            flex-direction: column;
            padding: 20px;
            flex-shrink: 0;
            z-index: 20;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }

        .brand-logo .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 8px;
            display: grid;
            place-items: center;
            font-weight: 900;
            color: #fff;
            font-size: 1.1rem;
        }

        .brand-logo h1 { font-size: 1.3rem; font-weight: 800; color: #fff; }

        .nav-section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-sub);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .nav-list { display: flex; flex-direction: column; gap: 8px; }

        .nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            border-radius: 10px;
            color: var(--text-sub);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            border: 1px solid transparent;
            cursor: pointer;
        }

        .nav-item:hover { background: rgba(255, 255, 255, 0.03); color: #fff; }
        .nav-item.active {
            background: rgba(59, 130, 246, 0.12);
            color: var(--accent-hover);
            border-color: rgba(59, 130, 246, 0.3);
            font-weight: 600;
        }

        .user-footer {
            margin-top: auto;
            border-top: 1px solid var(--panel-border);
            padding-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
        }

        .logout-btn {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 1px solid rgba(239, 68, 68, 0.2);
            padding: 4px 8px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.75rem;
        }

        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            height: 100vh;
        }

        header {
            height: 60px;
            border-bottom: 1px solid var(--panel-border);
            background: #0d131f;
            display: flex;
            align-items: center;
            padding: 0 25px;
            flex-shrink: 0;
        }

        header h2 { font-size: 1rem; font-weight: 600; }

        .page-view {
            flex: 1;
            display: none;
            height: calc(100vh - 60px);
            overflow: hidden;
        }
        .page-view.active { display: flex; }

        /* --- CONVERTISSEUR VIEW --- */
        .workspace {
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: 360px 1fr;
        }

        .controls-panel {
            background: var(--panel-bg);
            border-right: 1px solid var(--panel-border);
            padding: 20px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .control-block { display: flex; flex-direction: column; gap: 10px; }
        .control-block h3 { font-size: 0.8rem; text-transform: uppercase; color: var(--text-sub); font-weight: 700; }

        .dropzone {
            border: 2px dashed var(--panel-border);
            border-radius: 12px;
            padding: 20px 15px;
            text-align: center;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.2);
        }
        .dropzone:hover { border-color: var(--accent); background: rgba(59, 130, 246, 0.05); }
        .dropzone input { display: none; }

        .checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; cursor: pointer; }

        .palette-filter-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
        .btn-filter {
            background: #080b11;
            border: 1px solid var(--panel-border);
            color: var(--text-sub);
            padding: 6px 4px;
            border-radius: 6px;
            font-size: 0.72rem;
            cursor: pointer;
        }

        .palette-scroll {
            max-height: 180px;
            overflow-y: auto;
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            background: #080b11;
            padding: 6px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .color-row { display: flex; align-items: center; justify-content: space-between; padding: 5px 8px; border-radius: 6px; cursor: pointer; }
        .color-row:hover { background: rgba(255, 255, 255, 0.04); }
        .color-row.selected-draw { border: 1px solid var(--accent); background: rgba(59, 130, 246, 0.15); }
        .color-left { display: flex; align-items: center; gap: 10px; }
        .color-swatch { width: 18px; height: 18px; border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.2); }
        .badge-type { font-size: 0.65rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; }
        .type-free { color: #34d399; background: rgba(52, 211, 153, 0.1); }
        .type-pay { color: #fbbf24; background: rgba(251, 191, 36, 0.1); }

        .btn-group { display: flex; gap: 8px; }
        .btn-sm {
            flex: 1;
            background: #080b11;
            border: 1px solid var(--panel-border);
            color: #fff;
            padding: 8px;
            border-radius: 6px;
            font-size: 0.8rem;
            cursor: pointer;
            font-weight: 600;
        }
        .btn-sm:hover { border-color: var(--accent); }
        .btn-sm.active { background: var(--accent); border-color: var(--accent); }

        .preview-area {
            background: #06080d;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            height: 100%;
        }

        .canvas-container {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: 
                linear-gradient(45deg, #0d121d 25%, transparent 25%), 
                linear-gradient(-45deg, #0d121d 25%, transparent 25%), 
                linear-gradient(45deg, transparent 75%, #0d121d 75%), 
                linear-gradient(-45deg, transparent 75%, #0d121d 75%);
            background-size: 20px 20px;
            padding: 40px;
            overflow: auto;
        }

        canvas {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            box-shadow: 0 25px 60px rgba(0,0,0,0.9);
            border-radius: 4px;
            width: var(--zoom-size, 600px) !important;
            height: auto !important;
            object-fit: contain;
            transition: width 0.1s ease;
        }
        canvas.edit-mode { cursor: crosshair; }

        .toolbar-bottom {
            position: absolute;
            bottom: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(17, 24, 39, 0.9);
            border: 1px solid var(--panel-border);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 30px;
            z-index: 10;
        }
        .stat-item { font-size: 0.8rem; color: var(--text-sub); }
        .stat-item strong { color: #fff; }

        .btn-action {
            background: var(--success);
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
        }

        /* --- PARTAGE VIEW --- */
        .share-container {
            width: 100%;
            height: 100%;
            background: var(--bg-dark);
            padding: 30px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .share-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
        .share-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }

        .template-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .template-preview-box {
            width: 100%;
            height: 150px;
            background: #080b11;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--panel-border);
        }
        .template-preview-box img { max-width: 100%; max-height: 100%; image-rendering: pixelated; }

        .template-actions { display: flex; gap: 8px; }
        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--panel-border);
            color: #fff;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            cursor: pointer;
            flex: 1;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
        }

        /* --- CALCULATEUR VIEW --- */
        .calc-container {
            width: 100%;
            height: 100%;
            background: var(--bg-dark);
            padding: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-y: auto;
        }

        .calc-card {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            border-radius: 16px;
            padding: 30px;
            width: 100%;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }

        .calc-result-box {
            background: #080b11;
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            text-align: center;
        }

        .result-status {
            font-size: 1.5rem;
            font-weight: 800;
        }
        .status-yes { color: var(--success); }
        .status-no { color: var(--warning); }

        /* MODAL */
        #previewModal {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 500;
        }
        .modal-content {
            background: var(--panel-bg);
            border: 1px solid var(--panel-border);
            padding: 20px;
            border-radius: 12px;
            max-width: 600px;
            width: 90%;
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: center;
        }

        .loading-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(8, 11, 17, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-hover);
            font-weight: 700;
            z-index: 30;
        }

        .hidden { display: none !important; }
    </style>
</head>
<body>

    <!-- CONNEXION -->
    <div id="loginOverlay">
        <div class="login-card">
            <h2>Connexion TFO</h2>
            <p>Compte de test : <strong>test</strong> / <strong>test</strong></p>
            <div class="form-group">
                <label>Nom d'utilisateur</label>
                <input type="text" id="usernameInput" placeholder="ex: test, Antoine...">
            </div>
            <div class="form-group">
                <label>Mot de passe</label>
                <input type="password" id="passwordInput" placeholder="••••••••">
            </div>
            <button class="btn-primary" id="loginBtn">Se connecter</button>
            <p id="loginError" style="color: var(--danger); font-size: 0.8rem;" class="hidden">Identifiants incorrects !</p>
        </div>
    </div>

    <!-- MODAL APERÇU -->
    <div id="previewModal" class="hidden">
        <div class="modal-content">
            <h3 id="modalTitle">Aperçu du Template</h3>
            <div style="background:#080b11; padding:10px; border-radius:8px; width:100%; display:flex; justify-content:center;">
                <img id="modalImg" src="" alt="Aperçu">
            </div>
            <button class="btn-primary" onclick="document.getElementById('previewModal').classList.add('hidden')">Fermer</button>
        </div>
    </div>

    <!-- MENU LATÉRAL -->
    <div class="sidebar">
        <div class="brand-logo">
            <div class="logo-icon">T</div>
            <h1>TFO Tools</h1>
        </div>
        <div class="nav-section-title">Navigation</div>
        <div class="nav-list">
            <a href="#" class="nav-item active" data-target="converterView">Convertisseur WPLACE</a>
            <a href="#" class="nav-item" data-target="shareView">Espace Partage (Templates)</a>
            <a href="#" class="nav-item" data-target="calcView">Calculateur de Raid</a>
        </div>

        <div class="user-footer">
            <span>Compte : <strong id="currentUserName">test</strong></span>
            <button class="logout-btn" id="logoutBtn">Déconnexion</button>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-wrapper">
        <header>
            <h2 id="headerTitle">Convertisseur WPLACE</h2>
        </header>

        <!-- PAGE 1 : CONVERTISSEUR -->
        <div id="converterView" class="page-view active">
            <div class="workspace">
                <div class="controls-panel">
                    <div class="control-block">
                        <h3>1. Image Source</h3>
                        <div class="dropzone" id="dropzone">
                            <span style="font-size: 0.85rem; font-weight: 600;">Glisser-déposer une image</span>
                            <p style="font-size: 0.75rem; color: var(--text-sub); margin-top: 4px;">ou cliquer pour parcourir</p>
                            <input type="file" id="fileInput" accept="image/*">
                        </div>
                    </div>

                    <div class="control-block">
                        <h3>2. Dimensions (Pixels)</h3>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <input type="range" id="pixelRange" min="10" max="1000" value="120" style="flex:1;">
                            <input type="number" id="pixelInput" value="120" min="1" max="3000" style="width: 80px;">
                        </div>
                    </div>

                    <div class="control-block">
                        <h3>3. Algorithme de Couleurs</h3>
                        <select id="algoSelect">
                            <option value="ciede2000">CIEDE2000 (Perception ultra-précise)</option>
                            <option value="cielab">CIELAB (Standard équilibré)</option>
                            <option value="redmean">RGB Pondéré (Redmean)</option>
                            <option value="rgb">RGB Euclidien</option>
                            <option value="manhattan">Manhattan (Distance L1)</option>
                        </select>
                    </div>

                    <div class="control-block">
                        <h3>4. Ajustement Luminosité</h3>
                        <div class="btn-group">
                            <button class="btn-sm" id="btnBrighter">☀️ Plus clair</button>
                            <button class="btn-sm" id="btnDarker">🌙 Plus sombre</button>
                        </div>
                    </div>

                    <div class="control-block">
                        <h3>5. Mode Édition à la main</h3>
                        <button class="btn-sm" id="btnEditMode" style="width:100%;">✏️ Activer Edit Mode</button>
                        <div id="editTools" class="hidden" style="display:flex; gap:8px; margin-top:5px;">
                            <button class="btn-sm active" id="toolPencil">✏️ Crayon</button>
                            <button class="btn-sm" id="toolEraser">🧹 Gomme</button>
                        </div>
                    </div>

                    <div class="control-block">
                        <h3>6. Zoom & Tramage</h3>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <input type="range" id="zoomRange" min="200" max="1200" value="600" style="flex:1;">
                            <span id="zoomVal" style="font-size: 0.8rem; color: var(--text-sub);">600px</span>
                        </div>
                        <label class="checkbox-label" style="margin-top:6px;"><input type="checkbox" id="ditherToggle"> Activer le Tramage</label>
                        <label class="checkbox-label" style="margin-top:6px;"><input type="checkbox" id="removeBgToggle"> Supprimer le Fond Uni</label>
                        <div id="bgTolContainer" class="hidden" style="margin-top: 6px;">
                            <span style="font-size: 0.75rem; color: var(--text-sub);">Sensibilité :</span>
                            <input type="range" id="bgTolInput" min="1" max="100" value="25" style="width:100%">
                        </div>
                    </div>

                    <div class="control-block">
                        <h3>7. Palette WPLACE</h3>
                        <div class="palette-filter-grid">
                            <button class="btn-filter" id="btnAll">Tout</button>
                            <button class="btn-filter" id="btnNone">Aucun</button>
                            <button class="btn-filter" id="btnFree">Gratuites</button>
                            <button class="btn-filter" id="btnPay">Payantes</button>
                        </div>
                        <div class="palette-scroll" id="paletteList"></div>
                    </div>
                </div>

                <div class="preview-area">
                    <div id="loading" class="loading-overlay hidden">Traitement...</div>
                    <div class="canvas-container">
                        <p id="placeholder" style="color: var(--text-sub); font-size: 0.9rem;">Importez une image</p>
                        <canvas id="pixelCanvas" class="hidden"></canvas>
                    </div>

                    <div class="toolbar-bottom hidden" id="toolbar">
                        <div class="stat-item">Grille: <strong id="statDim">0 x 0</strong> px</div>
                        <div class="stat-item">Total: <strong id="statTotal">0</strong></div>
                        <button class="btn-action" id="downloadBtn">Télécharger</button>
                        <button class="btn-action" id="publishBtn" style="background:var(--accent);">Publier</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAGE 2 : ESPACE PARTAGE -->
        <div id="shareView" class="page-view">
            <div class="share-container">
                <div class="share-header">
                    <div>
                        <h3 style="font-size: 1.3rem; color:#fff;">Templates WPLACE Partagés</h3>
                        <p style="font-size: 0.85rem; color:var(--text-sub);">Recherchez par nom d'auteur pour télécharger et aider</p>
                    </div>
                    <div style="width: 300px;">
                        <input type="text" id="searchInput" placeholder="Rechercher par auteur..." style="width:100%;">
                    </div>
                </div>

                <div class="share-grid" id="templatesGrid"></div>
            </div>
        </div>

        <!-- PAGE 3 : CALCULATEUR DE RAID -->
        <div id="calcView" class="page-view">
            <div class="calc-container">
                <div class="calc-card">
                    <h3 style="font-size: 1.2rem; color: #fff; border-bottom: 1px solid var(--panel-border); padding-bottom: 10px;">Calculateur de Pixels (Raid WPLACE)</h3>
                    <p style="font-size: 0.8rem; color: var(--text-sub);">Règle de régénération : 1 pixel toutes les 30 secondes.</p>

                    <div class="form-group">
                        <label>Vos pixels actuels</label>
                        <input type="number" id="calcCurrent" value="50" min="0">
                    </div>

                    <div class="form-group">
                        <label>Votre stock maximum de pixels (Capacité max)</label>
                        <input type="number" id="calcMax" value="200" min="1">
                    </div>

                    <div class="form-group">
                        <label>Date et Heure du Raid</label>
                        <input type="datetime-local" id="calcDate">
                    </div>

                    <div class="calc-result-box">
                        <span style="font-size: 0.8rem; color: var(--text-sub); text-transform: uppercase; font-weight: 700;">Prédiction pour le Raid</span>
                        <div class="result-status" id="calcStatusText">—</div>
                        <p id="calcDetailsText" style="font-size: 0.9rem; color: var(--text-main);">Remplissez les informations ci-dessus pour calculer.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // CONNEXION
        const USERS = { "test": "test" };
        let currentUser = null;

        const loginOverlay = document.getElementById('loginOverlay');
        const loginBtn = document.getElementById('loginBtn');
        const usernameInput = document.getElementById('usernameInput');
        const passwordInput = document.getElementById('passwordInput');
        const loginError = document.getElementById('loginError');
        const currentUserName = document.getElementById('currentUserName');
        const logoutBtn = document.getElementById('logoutBtn');

        loginBtn.addEventListener('click', () => {
            const u = usernameInput.value.trim();
            const p = passwordInput.value.trim();
            if (USERS[u] && USERS[u] === p) {
                currentUser = u;
                currentUserName.textContent = u;
                loginOverlay.classList.add('hidden');
            } else {
                loginError.classList.add('hidden');
                loginError.classList.remove('hidden');
            }
        });

        logoutBtn.addEventListener('click', () => {
            currentUser = null;
            usernameInput.value = '';
            passwordInput.value = '';
            loginError.classList.add('hidden');
